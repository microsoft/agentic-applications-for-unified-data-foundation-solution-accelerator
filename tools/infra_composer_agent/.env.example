# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored -- never commit real secrets/keys.
#
# Azure AI Foundry (required -- the agent always uses AI Foundry, no fallback)
AI_FOUNDRY_PROJECT_ENDPOINT=https://<project>.services.ai.azure.com/api/projects/<project-name>
AI_FOUNDRY_MODEL_DEPLOYMENT=gpt-4o
# Optional: override the pre-created persistent agent IDs (defaults live in
# llm_interpreter.py / llm_composer.py)
# AI_FOUNDRY_INTERPRETER_AGENT_ID=asst_...
# AI_FOUNDRY_AUTHOR_AGENT_ID=asst_...

# GitHub App auth (optional -- omit all three to fall back to your local
# git credential helper / personal GitHub login instead)
# GH_APP_ID=123456
# GH_APP_PRIVATE_KEY_PATH=C:\Users\<you>\.secrets\infra-composer-agent-bot.pem
# GH_APP_INSTALLATION_ID=12345678
